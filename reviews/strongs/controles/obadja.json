},{"woord":"zij","start":179,"eind":182},{"woord":"een","start":188,"eind":191},{"woord":"hebben","start":201,"eind":207}]},{"ref":"obadja/1/6","tekst":"Hoe zijn Ezau's goederen nagespeurd, zijn verborgen schatten opgezocht!","woorden":[{"woord":"zijn","start":4,"eind":8},{"woord":"goederen","start":16,"eind":24},{"woord":"zijn","start":37,"eind":41},{"woord":"verborgen","start":42,"eind":51}]},{"ref":"obadja/1/7","tekst":"Al uw bondgenoten hebben u tot aan de grens uitgeleid; uw vredegenoten hebben u bedrogen, zij hebben u overweldigd; die uw brood eten, zullen een gezwel onder u zetten, er is geen verstand in hem.","woorden":[{"woord":"uw","start":3,"eind":5},{"woord":"hebben","start":18,"eind":24},{"woord":"u","start":25,"eind":26},{"woord":"aan","start":31,"eind":34},{"woord":"de","start":35,"eind":37},{"woord":"uw","start":55,"eind":57},{"woord":"hebben","start":71,"eind":77},{"woord":"u","start":78,"eind":79},{"woord":"zij","start":90,"eind":93},{"woord":"hebben","start":94,"eind":100},{"woord":"u","start":101,"eind":102},{"woord":"die","start":116,"eind":119},{"woord":"uw","start":120,"eind":122},{"woord":"eten","start":129,"eind":133},{"woord":"zullen","start":135,"eind":141},{"woord":"een","start":142,"eind":145},{"woord":"u","start":159,"eind":160},{"woord":"er","start":169,"eind":171},{"woord":"is","start":172,"eind":174},{"woord":"in","start":189,"eind":191},{"woord":"hem","start":192,"eind":195}]},{"ref":"obadja/1/8","tekst":" Zal het niet op die dag zijn, spreekt JAHWEH, dat Ik de wijzen uit Edom, en het verstand uit Ezau's gebergte zal doen vergaan?","woorden":[{"woord":"Zal","start":1,"eind":4},{"woord":"het","start":5,"eind":8},{"woord":"op","start":14,"eind":16},{"woord":"zijn","start":25,"eind":29},{"woord":"dat","start":47,"eind":50},{"woord":"Ik","start":51,"eind":53},{"woord":"de","start":54,"eind":56},{"woord":"uit","start":64,"eind":67},{"woord":"en","start":74,"eind":76},{"woord":"het","start":77,"eind":80},{"woord":"uit","start":90,"eind":93},{"woord":"zal","start":110,"eind":113},{"woord":"doen","start":114,"eind":118}]},{"ref":"obadja/1/9","tekst":"Ook zullen uw helden, o Theman! versaagd zijn; opdat een ieder uit Ezau's gebergte door de moord wordt uitgeroeid.","woorden":[{"woord":"Ook","start":0,"eind":3},{"woord":"zullen","start":4,"eind":10},{"woord":"uw","start":11,"eind":13},{"woord":"o","start":22,"eind":23},{"woord":"zijn","start":41,"eind":45},{"woord":"een","start":53,"eind":56},{"woord":"uit","start":63,"eind":66},{"woord":"door","start":83,"eind":87},{"woord":"de","start":88,"eind":90},{"woord":"wordt","start":97,"eind":102}]},{"ref":"obadja/1/10","tekst":"Om het geweld, begaan aan uw broer Jakob, zal schaamte u bedekken; en u zult uitgeroeid worden in eeuwigheid.","woorden":[{"woord":"Om","start":0,"eind":2},{"woord":"het","start":3,"eind":6},{"woord":"begaan","start":15,"eind":21},{"woord":"aan","start":22,"eind":25},{"woord":"uw","start":26,"eind":28},{"woord":"zal","start":42,"eind":45},{"woord":"u","start":55,"eind":56},{"woord":"en","start":67,"eind":69},{"woord":"u","start":70,"eind":71},{"woord":"zult","start":72,"eind":76},{"woord":"worden","start":88,"eind":94},{"woord":"in","start":95,"eind":97}]},{"ref":"obadja/1/11","tekst":"Op de dag als u tegenover stondt, op de dag als de buitenlanders zijn leger gevangen voerden, en de vreemden tot zijn poorten introkken, en over Jeruzalem het lot wierpen, was u ook als één van hen.","woorden":[{"woord":"Op","start":0,"eind":2},{"woord":"de","start":3,"eind":5},{"woord":"als","start":10,"eind":13},{"woord":"u","start":14,"eind":15},{"woord":"op","start":34,"eind":36},{"woord":"de","start":37,"eind":39},{"woord":"als","start":44,"eind":47},{"woord":"de","start":48,"eind":50},{"woord":"zijn","start":65,"eind":69},{"woord":"voerden","start":85,"eind":92},{"woord":"en","start":94,"eind":96},{"woord":"de","start":97,"eind":99},{"woord":"tot","start":109,"eind":112},{"woord":"zijn","start":113,"eind":117},{"woord":"en","start":137,"eind":139},