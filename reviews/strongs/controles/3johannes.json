{"boek":"3johannes","inhoudelijke_controle_voltooid":false,"verzen":15,"koppelingen":191,"verzen_zonder_grondtekst":0,"verzen_zonder_koppelingslaag":0,"fouten":[],"woorden_zonder_link":[{"ref":"3johannes/1/1","tekst":" De ouderling aan de geliefde Gajus, die ik in waarheid liefheb.","woorden":[{"woord":"aan","start":14,"eind":17},{"woord":"de","start":18,"eind":20}]},{"ref":"3johannes/1/2","tekst":"Geliefde, voor alle dingen wens ik, dat het u welvaart en u gezond bent, zoals het uw ziel welvaart.","woorden":[{"woord":"ik","start":32,"eind":34},{"woord":"dat","start":36,"eind":39},{"woord":"het","start":40,"eind":43},{"woord":"u","start":58,"eind":59},{"woord":"het","start":79,"eind":82}]},{"ref":"3johannes/1/3","tekst":"Want ik ben zeer verblijd geweest, als de broeders kwamen, en getuigden van uw waarheid, zoals u in de waarheid wandelt.","woorden":[{"woord":"ik","start":5,"eind":7},{"woord":"ben","start":8,"eind":11},{"woord":"als","start":35,"eind":38},{"woord":"de","start":39,"eind":41},{"woord":"van","start":72,"eind":75},{"woord":"de","start":100,"eind":102}]},{"ref":"3johannes/1/4","tekst":"Ik heb geen meerdere blijdschap dan hierin, dat ik hoor, dat mijn kinderen in de waarheid wandelen.","woorden":[{"woord":"Ik","start":0,"eind":2},{"woord":"dan","start":32,"eind":35},{"woord":"ik","start":48,"eind":50},{"woord":"dat","start":57,"eind":60},{"woord":"de","start":78,"eind":80}]},{"ref":"3johannes/1/5","tekst":"Geliefde, u doet trouw, in al wat u doet aan de broeders en aan de vreemdelingen,","woorden":[{"woord":"u","start":10,"eind":11},{"woord":"in","start":24,"eind":26},{"woord":"u","start":34,"eind":35},{"woord":"de","start":45,"eind":47},{"woord":"de","start":64,"eind":66}]},{"ref":"3johannes/1/6","tekst":"Die getuigd hebben van uw liefde, in de aanwezigheid van de Gemeente; die als u geleide doet, zoals het voor God waard is, zo zult u weldoen.","woorden":[{"woord":"van","start":19,"eind":22},{"woord":"in","start":34,"eind":36},{"woord":"de","start":37,"eind":39},{"woord":"van","start":53,"eind":56},{"woord":"de","start":57,"eind":59},{"woord":"als","start":74,"eind":77},{"woord":"u","start":78,"eind":79},{"woord":"zoals","start":94,"eind":99},{"woord":"het","start":100,"eind":103},{"woord":"voor","start":104,"eind":108},{"woord":"is","start":119,"eind":121},{"woord":"zo","start":123,"eind":125},{"woord":"zult","start":126,"eind":130},{"woord":"u","start":131,"eind":132}]},{"ref":"3johannes/1/7","tekst":"Want zij zijn voor Zijn Naam uitgegaan, niets nemende van de heidenen.","woorden":[{"woord":"zij","start":5,"eind":8},{"woord":"Zijn","start":19,"eind":23},{"woord":"de","start":58,"eind":60}]},{"ref":"3johannes/1/8","tekst":"Wij dan zijn schuldig zulke mensen te ontvangen, opdat wij medearbeiders mogen worden van de waarheid.","woorden":[{"woord":"wij","start":55,"eind":58},{"woord":"van","start":86,"eind":89},{"woord":"de","start":90,"eind":92}]},{"ref":"3johannes/1/9","tekst":"Ik heb aan de Gemeente geschreven; maar Diotrefes, die onder hen zoekt de eerste te zijn, neemt ons niet aan.","woorden":[{"woord":"Ik","start":0,"eind":2},{"woord":"heb","start":3,"eind":6},{"woord":"aan","start":7,"eind":10},{"woord":"de","start":11,"eind":13},{"woord":"onder","start":55,"eind":60},{"woord":"zoekt","start":65,"eind":70},{"woord":"de","start":71,"eind":73},{"woord":"te","start":81,"eind":83},{"woord":"zijn","start":84,"eind":88},{"woord":"aan","start":105,"eind":108}]},{"ref":"3johannes/1/10","tekst":"Daarom, als ik kom, zo zal ik in herinnering brengen zijn werken, die hij doet, met boze woorden snaterende tegen ons; en hiermee niet tevreden zijnde, zo ontvangt hij zelf de broeders niet, en verhindert degenen, die het willen doen, en werpt ze uit de Gemeente.","woorden":[{"woord":"ik","start":12,"eind":14},{"woord":"zo","start":20,"eind":22},{"woord":"zal","start":23,"eind":26},{"woord":"ik","start":27,"eind":29},{"woord":"in","start":30,"eind":32},{"woord":"hij","start":70,"eind":73},{"woord":"met","start":80,"eind":83},{"woord":"tegen","start":108,"eind":113},{"woord":"zo","start":152,"eind":154},{"woord":"hij","start":164,"eind":167},{"woord":"die","start":214,"eind":217},{"woord":"het","start":218,"eind":221},{"woord":"doen","start":229,"eind":233},{"woord":"ze","start":244,"eind":246},{"woord":"de","start":251,"eind":253}]},{"ref":"3johannes/1/11","tekst":"Geliefde, volgt het kwade niet na, maar het goede. Die goed doet, is uit God; maar die kwaad doet, heeft God niet gezien.","woorden":[{"woord":"het","start":16,"eind":19},{"woord":"na","start":31,"eind":33},{"woord":"heeft","start":99,"eind":104}]},{"ref":"3johannes/1/12","tekst":"Aan Demetrius wordt getuigenis gegeven van allen, en van de waarheid zelf; en wij getuigen ook, en u weet, dat onze getuigenis waarachtig is.","woorden":[{"woord":"Aan","start":0,"eind":3},{"woord":"wordt","start":14,"eind":19},{"woord":"de","start":57,"eind":59},{"woord":"u","start":99,"eind":100}]},{"ref":"3johannes/1/13","tekst":" Ik had veel te schrijven, maar ik wil u niet schrijven met inkt en pen;","woorden":[{"woord":"Ik","start":1,"eind":3},{"woord":"ik","start":32,"eind":34}]},{"ref":"3johannes/1/14","tekst":"Maar ik hoop u haast te zien, en wij zullen mond tot mond spreken.","woorden":[{"woord":"ik","start":5,"eind":7},{"woord":"wij","start":33,"eind":36},{"woord":"zullen","start":37,"eind":43}]},{"ref":"3johannes/1/15","tekst":" Vrede zij u. De vrienden groeten u. Groet de vrienden met name.","woorden":[{"woord":"zij","start":7,"eind":10}]}],"aantal_woorden_zonder_link":81}
