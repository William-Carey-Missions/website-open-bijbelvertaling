{"boek":"obadja","inhoudelijke_controle_voltooid":false,"verzen":21,"koppelingen":280,"verzen_zonder_grondtekst":0,"verzen_zonder_koppelingslaag":0,"fouten":[],"woorden_zonder_link":[{"ref":"obadja/1/1","tekst":"Het visioen van Obadja. Zo zegt Adonai JAHWEH van Edom: Wij hebben een gerucht gehoord van JAHWEH, en er is een gezant geschikt onder de heidenen: Sta op, en laat ons opstaan tegen hen ten strijde.","woorden":[{"woord":"Het","start":0,"eind":3},{"woord":"van","start":12,"eind":15},{"woord":"van","start":46,"eind":49},{"woord":"Wij","start":56,"eind":59},{"woord":"hebben","start":60,"eind":66},{"woord":"een","start":67,"eind":70},{"woord":"en","start":99,"eind":101},{"woord":"er","start":102,"eind":104},{"woord":"is","start":105,"eind":107},{"woord":"een","start":108,"eind":111},{"woord":"onder","start":128,"eind":133},{"woord":"de","start":134,"eind":136},{"woord":"op","start":151,"eind":153},{"woord":"en","start":155,"eind":157},{"woord":"laat","start":158,"eind":162},{"woord":"ons","start":163,"eind":166},{"woord":"hen","start":181,"eind":184},{"woord":"ten","start":185,"eind":188}]},{"ref":"obadja/1/2","tekst":"Zie, Ik heb u klein gemaakt onder de heidenen, u bent zeer veracht.","woorden":[{"woord":"Ik","start":5,"eind":7},{"woord":"heb","start":8,"eind":11},{"woord":"u","start":12,"eind":13},{"woord":"onder","start":28,"eind":33},{"woord":"de","start":34,"eind":36},{"woord":"bent","start":49,"eind":53}]},{"ref":"obadja/1/3","tekst":"De trotsheid van uw hart heeft u bedrogen; hij, die daar woont in de kloven van de steenrotsen, in zijn hoge woning; die in zijn hart zegt: Wie zou mij ter aarde neerstoten?","woorden":[{"woord":"De","start":0,"eind":2},{"woord":"van","start":13,"eind":16},{"woord":"uw","start":17,"eind":19},{"woord":"heeft","start":25,"eind":30},{"woord":"u","start":31,"eind":32},{"woord":"hij","start":43,"eind":46},{"woord":"die","start":48,"eind":51},{"woord":"daar","start":52,"eind":56},{"woord":"in","start":63,"eind":65},{"woord":"de","s