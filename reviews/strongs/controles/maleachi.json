,"eind":66},{"woord":"de","start":67,"eind":69},{"woord":"zolen","start":70,"eind":75},{"woord":"van","start":76,"eind":79},{"woord":"uw","start":80,"eind":82},{"woord":"voeten","start":83,"eind":89},{"woord":"op","start":91,"eind":93},{"woord":"die","start":94,"eind":97},{"woord":"dag","start":98,"eind":101},{"woord":"die","start":103,"eind":106},{"woord":"Ik","start":107,"eind":109},{"woord":"maken","start":110,"eind":115},{"woord":"zal","start":116,"eind":119},{"woord":"zegt","start":121,"eind":125},{"woord":"JAHWEH","start":126,"eind":132},{"woord":"van","start":133,"eind":136},{"woord":"de","start":137,"eind":139},{"woord":"legermachten","start":140,"eind":152}]},{"ref":"maleachi/4/4","tekst":" Gedenk de wet van Mozes, Mijn knecht, die Ik hem bevolen heb op Horeb aan geheel Israël, de voorschriften en rechten.","woorden":[{"woord":"Gedenk","start":1,"eind":7},{"woord":"de","start":8,"eind":10},{"woord":"wet","start":11,"eind":14},{"woord":"van","start":15,"eind":18},{"woord":"Mozes","start":19,"eind":24},{"woord":"Mijn","start":26,"eind":30},{"woord":"knecht","start":31,"eind":37},{"woord":"die","start":39,"eind":42},{"woord":"Ik","start":43,"eind":45},{"woord":"hem","start":46,"eind":49},{"woord":"bevolen","start":50,"eind":57},{"woord":"heb","start":58,"eind":61},{"woord":"op","start":62,"eind":64},{"woord":"Horeb","start":65,"eind":70},{"woord":"aan","start":71,"eind":74},{"woord":"geheel","start":75,"eind":81},{"woord":"Israël","start":82,"eind":88},{"woord":"de","start":90,"eind":92},{"woord":"voorschriften","start":93,"eind":106},{"woord":"en","start":107,"eind":109},{"woord":"rechten","start":110,"eind":117}]},{"ref":"maleachi/4/5","tekst":"Zie, Ik zend u de profeet Elia, voordat die grote en die vreselijke dag van JAHWEH komen zal.","woorden":[{"woord":"Zie","start":0,"eind":3},{"woord":"Ik","start":5,"eind":7},{"woord":"zend","start":8,"eind":12},{"woord":"u","start":13,"eind":14},{"woord":"de","start":15,"eind":17},{"woord":"profeet","start":18,"eind"