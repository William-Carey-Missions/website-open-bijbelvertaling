en","start":129,"eind":135},{"woord":"zullen","start":146,"eind":152},{"woord":"en","start":160,"eind":162},{"woord":"en","start":175,"eind":177},{"woord":"zal","start":186,"eind":189},{"woord":"hen","start":190,"eind":193}]},{"ref":"zefanja/3/14","tekst":"Zing vrolijk, u dochter van Sion, juich, Israël; wees blij, en spring op van vreugde met heel uw hart, u dochter van Jeruzalem!","woorden":[{"woord":"vrolijk","start":5,"eind":12},{"woord":"u","start":14,"eind":15},{"woord":"van","start":24,"eind":27},{"woord":"wees","start":49,"eind":53},{"woord":"en","start":60,"eind":62},{"woord":"op","start":70,"eind":72},{"woord":"van","start":73,"eind":76},{"woord":"vreugde","start":77,"eind":84},{"woord":"met","start":85,"eind":88},{"woord":"uw","start":94,"eind":96},{"woord":"u","start":103,"eind":104},{"woord":"van","start":113,"eind":116}]},{"ref":"zefanja/3/15","tekst":"JAHWEH heeft uw oordelen weggenomen, Hij heeft uw vijand weggevaagd; de Koning van Israël, JAHWEH, is in het midden van u, u zult geen kwaad meer zien.","woorden":[{"woord":"heeft","start":7,"eind":12},{"woord":"uw","start":13,"eind":15},{"woord":"Hij","start":37,"eind":40},{"woord":"heeft","start":41,"eind":46},{"woord":"uw","start":47,"eind":49},{"woord":"de","start":69,"eind":71},{"woord":"van","start":79,"eind":82},{"woord":"is","start":99,"eind":101},{"woord":"in","start":102,"eind":104},{"woord":"het","start":105,"eind":108},{"woord":"van","start":116,"eind":119},{"woord":"u","start":120,"eind":121},{"woord":"u","start":123,"eind":124},{"woord":"zult","start":125,"eind":129}]},{"ref":"zefanja/3/16","tekst":"Op die dag zal tot Jeruzalem gezegd worden: Vrees niet, o Sion! laat uw handen niet slap worden.","woorden":[{"woord":"Op","start":0,"eind":2},{"woord":"zal","start":11,"eind":14},{"woord":"tot","start":15,"eind":18},{"woord":"worden","start":36,"eind":42},{"woord":"o","start":56,"eind":57},{"woord":"laat","start":64,"eind":68},{"woord":"uw","start":69,"eind":71},{"woord":"worden","start":89,"eind":95}]},{"ref":"zefanja/3/17","tekst":"JAHWEH, uw God, is in het midden van u, een Held, Die verlossen zal; Hij zal over u vrolijk zijn met blijdschap, Hij zal zwijgen in Zijn liefde, Hij zal Zich over u verheugen met gejuich.","woorden":[{"woord":"uw","start":8,"eind":10},{"woord":"is","start":16,"eind":18},{"woord":"in","start":19,"eind":21},{"woord":"het","start":22,"eind":25},{"woord":"van","start":33,"eind":36},{"woord":"u","start":37,"eind":38},{"woord":"een","start":40,"eind":43},{"woord":"Die","start":50,"eind":53},{"woord":"zal","start":64,"eind":67},{"woord":"Hij","start":69,"eind":72},{"woord":"zal","start":73,"eind":76},{"woord":"zijn","start":92,"eind":96},{"woord":"met","start":97,"eind":100},{"woord":"Hij","start":113,"eind":116},{"woord":"zal","start":117,"eind":120},{"woord":"in","start":129,"eind":131},{"woord":"Zijn","start":132,"eind":136},{"woord":"Hij","start":145,"eind":148},{"woord":"zal","start":149,"eind":152},{"woord":"Zich","start":153,"eind":157},{"woord":"met","start":175,"eind":178}]},{"ref":"zefanja/3/18","tekst":" De bedroefden, vanwege de bijeenkomst, zal Ik verzamelen, zij zijn uit u; de schimping is een last op haar.","woorden":[{"woord":"De","start":1,"eind":3},{"woord":"vanwege","start":16,"eind":23},{"woord":"de","start":24,"eind":26},{"woord":"zal","start":40,"eind":43},{"woord":"Ik","start":44,"eind":46},{"woord":"zij","start":59,"eind":62},{"woord":"de","start":75,"eind":77},{"woord":"is","start":88,"eind":90},{"woord":"een","start":91,"eind":94}]},{"ref":"zefanja/3/19","tekst":"Zie, Ik zal in die tijd al uw verdrukkers verdoen; en Ik zal de hinkenden behoeden, en de uitgestotenen verzamelen; en Ik zal ze stellen tot een lof, en tot een naam, in het hele land, waar zij beschaamd zijn geweest.","woorden":[{"woord":"Ik","start":5,"eind":7},{"woord":"zal","start":8,"eind":11},{"woord":"in","start":12,"eind":14},{"woord":"uw","start":27,"eind":29},{"woord":"en","start":51,"eind":53},{"woord":"Ik","start":54,"eind":56},{"woord"