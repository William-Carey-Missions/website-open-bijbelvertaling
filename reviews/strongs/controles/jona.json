","start":203,"eind":205},{"woord":"neer","start":210,"eind":214},{"woord":"en","start":216,"eind":218},{"woord":"was","start":219,"eind":222},{"woord":"met","start":223,"eind":226},{"woord":"een","start":227,"eind":230},{"woord":"diepe","start":231,"eind":236},{"woord":"bevangen","start":243,"eind":251}]},{"ref":"jona/1/6","tekst":"En de opperschipper naderde tot hem, en zei tot hem: Wat is u, u hardslapende? Sta op, roep tot uw God, misschien zal die God aan ons gedenken, dat wij niet vergaan.","woorden":[{"woord":"En","start":0,"eind":2},{"woord":"de","start":3,"eind":5},{"woord":"hem","start":32,"eind":35},{"woord":"en","start":37,"eind":39},{"woord":"tot","start":44,"eind":47},{"woord":"hem","start":48,"eind":51},{"woord":"is","start":57,"eind":59},{"woord":"u","start":60,"eind":61},{"woord":"u","start":63,"eind":64},{"woord":"op","start":83,"eind":85},{"woord":"uw","start":96,"eind":98},{"woord":"zal","start":114,"eind":117},{"woord":"die","start":118,"eind":121},{"woord":"aan","start":126,"eind":129},{"woord":"ons","start":130,"eind":133},{"woord":"dat","start":144,"eind":147},{"woord":"wij","start":148,"eind":151}]},{"ref":"jona/1/7","tekst":"Verder zeiden zij, een ieder tot zijn metgezel: Kom, en laat ons loten werpen, opdat wij mogen weten, om wiens wil ons dit kwaad overkomt. Zo wierpen zij loten, en het lot viel op Jona.","woorden":[{"woord":"Verder","start":0,"eind":6},{"woord":"zij","start":14,"eind":17},{"woord":"een","start":19,"eind":22},{"woord":"zijn","start":33,"eind":37},{"woord":"en","start":53,"eind":55},{"woord":"laat","start":56,"eind":60},{"woord":"ons","start":61,"eind":64},{"woord":"opdat","start":79,"eind":84},{"woord":"wij","start":85,"eind":88},{"woord":"mogen","start":89,"eind":94},{"woord":"om","start":102,"eind":104},{"woord":"wil","start":111,"eind":114},{"woord":"ons","start":115,"eind":118},{"woord":"overkomt","start":129,"eind":137},{"woord":"Zo","start":139,"eind":141},{"woord":"zij","start":150,"eind":153},{"woord":"en","start":161,"eind":163},{"woord":"het","start":164,"eind":167}]},{"ref":"jona/1/8","tekst":"Toen zeiden zij tot hem: Verklaar ons nu, om wie de wil ons dit kwaad overkomt. Wat is uw werk en vanwaar komt u? Welk is uw land en van welk volk bent u?","woorden":[{"woord":"Toen","start":0,"eind":4},{"woord":"zij","start":12,"eind":15},{"woord":"hem","start":20,"eind":23},{"woord":"ons","start":34,"eind":37},{"woord":"om","start":42,"eind":44},{"woord":"de","start":49,"eind":51},{"woord":"ons","start":56,"eind":59},{"woord":"overkomt","start":70,"eind":78},{"woord":"is","start":84,"eind":86},{"woord":"uw","start":87,"eind":89},{"woord":"en","start":95,"eind":97},{"woord":"u","start":111,"eind":112},{"woord":"is","start":119,"eind":121},{"woord":"uw","start":122,"eind":124},{"woord":"en","start":130,"eind":132},{"woord":"van","start":133,"eind":136},{"woord":"bent","start":147,"eind":151}]},{"ref":"jona/1/9","tekst":"En hij zei tot hen: Ik ben een Hebreër; en ik vrees JAHWEH, de God van de hemel, Die de zee en het droge gemaakt heeft.","woorden":[{"woord":"En","start":0,"eind":2},{"woord":"hij","start":3,"eind":6},{"woord":"hen","start":15,"eind":18},{"woord":"ben","start":23,"eind":26},{"woord":"een","start":27,"eind":30},{"woord":"en","start":40,"eind":42},{"woord":"de","start":60,"eind":62},{"woord":"van","start":67,"eind":70},{"woord":"de","start":71,"eind":73},{"woord":"de","start":85,"eind":87},{"woord":"en","start":92,"eind":94},{"woord":"het","start":95,"eind":98},{"woord":"heeft","start":113,"eind":118}]},{"ref":"jona/1/10","tekst":"Toen vreesden die mannen met grote vrees, en zeiden tot hem: Wat hebt u dit gedaan? Want de mannen wisten, dat hij van het aangezicht van JAHWEH vluchtte; want hij had het hun te kennen gegeven.","woorden":[{"woord":"Toen","start":0,"eind":4},{"woord":"die","start":14,"eind":17},{"woord":"met","start":25,"eind":28},{"woord":"en","start":42,"eind":44},{"woord":"hem","start":56,"eind":59},{"woord":"hebt","start":65,"eind":69},{"woord":"u","sta