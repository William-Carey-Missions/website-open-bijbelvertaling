s","start":153,"eind":156}]},{"ref":"habakuk/1/10","tekst":"En hij zal de koningen beschimpen, en de prinsen zullen hem een belaching zijn; hij zal alle vesting belachen; want hij zal stof verzamelen, en hij zal ze innemen.","woorden":[{"woord":"En","start":0,"eind":2},{"woord":"zal","start":7,"eind":10},{"woord":"de","start":11,"eind":13},{"woord":"en","start":35,"eind":37},{"woord":"de","start":38,"eind":40},{"woord":"zullen","start":49,"eind":55},{"woord":"hem","start":56,"eind":59},{"woord":"een","start":60,"eind":63},{"woord":"zijn","start":74,"eind":78},{"woord":"zal","start":84,"eind":87},{"woord":"want","start":111,"eind":115},{"woord":"hij","start":116,"eind":119},{"woord":"zal","start":120,"eind":123},{"woord":"en","start":141,"eind":143},{"woord":"hij","start":144,"eind":147},{"woord":"zal","start":148,"eind":151},{"woord":"ze","start":152,"eind":154}]},{"ref":"habakuk/1/11","tekst":" Dan zal hij de geest veranderen, en hij zal doortrekken, en zich schuldig maken, houdende deze zijn kracht voor zijn God.","woorden":[{"woord":"zal","start":5,"eind":8},{"woord":"hij","start":9,"eind":12},{"woord":"de","start":13,"eind":15},{"woord":"en","start":34,"eind":36},{"woord":"hij","start":37,"eind":40},{"woord":"zal","start":41,"eind":44},{"woord":"en","start":58,"eind":60},{"woord":"zich","start":61,"eind":65},{"woord":"maken","start":75,"eind":80},{"woord":"houdende","start":82,"eind":90},{"woord":"zijn","start":96,"eind":100},{"woord":"voor","start":108,"eind":112},{"woord":"zijn","start":113,"eind":117}]},{"ref":"habakuk/1/12","tekst":"Bent U niet van ouds af JAHWEH, mijn God, mijn Heilige? Wij zullen niet sterven; o JAHWEH! tot een oordeel hebt U hem gesteld, en o Rots! om te straffen, hebt U hem gegrondvest.","woorden":[{"woord":"Bent","start":0,"eind":4},{"woord":"van","start":12,"eind":15},{"woord":"af","start":21,"eind":23},{"woord":"mijn","start":32,"eind":36},{"woord":"mijn","start":42,"eind":46},{"woord":"Wij","start":56,"eind":59},{"woord":"zullen","start":60,"eind":66},{"woord":"o","start":81,"eind":82},{"woord":"tot","start":91,"eind":94},{"woord":"een","start":95,"eind":98},{"woord":"hebt","start":107,"eind":111},{"woord":"U","start":112,"eind":113},{"woord":"hem","start":114,"eind":117},{"woord":"en","start":127,"eind":129},{"woord":"o","start":130,"eind":131},{"woord":"om","start":138,"eind":140},{"woord":"te","start":141,"eind":143},{"woord":"hebt","start":154,"eind":158},{"woord":"U","start":159,"eind":160},{"woord":"hem","start":161,"eind":164}]},{"ref":"habakuk/1/13","tekst":"U bent te rein van ogen, dan dat U het kwade zou zien, en de kwelling kunt U niet aanschouwen; waarom zou U aanschouwen die trouweloos handelen? Waarom zou U zwijgen, als de goddeloze die verslindt, die rechtvaardiger is dan hij?","woorden":[{"woord":"U","start":0,"eind":1},{"woord":"bent","start":2,"eind":6},{"woord":"te","start":7,"eind":9},{"woord":"van","start":15,"eind":18},{"woord":"dan","start":25,"eind":28},{"woord":"dat","start":29,"eind":32},{"woord":"U","start":33,"eind":34},{"woord":"het","start":35,"eind":38},{"woord":"zou","start":45,"eind":48},{"woord":"en","start":55,"eind":57},{"woord":"de","start":58,"eind":60},{"woord":"U","start":75,"eind":76},{"woord":"zou","start":102,"eind":105},{"woord":"U","start":106,"eind":107},{"woord":"die","start":120,"eind":123},{"woord":"handelen","start":135,"eind":143},{"woord":"Waarom","start":145,"eind":151},{"woord":"zou","start":152,"eind":155},{"woord":"U","start":156,"eind":157},{"woord":"als","start":167,"eind":170},{"woord":"de","start":171,"eind":173},{"woord":"die","start":184,"eind":187},{"woord":"die","start":199,"eind":202},{"woord":"is","start":218,"eind":220}]},{"ref":"habakuk/1/14","tekst":"En waarom zou U de mensen maken, als de vissen van de zee, als het kruipend gedierte, dat geen heerser heeft?","woorden":[{"woord":"En","start":0,"eind":2},{"woord":"waarom","start":3,"eind":9},{"woord":"zou","start":10,"eind":13},{"woord":"U","start":14,"eind":15},{"woord":"de","start":16,"eind":18},{"woord":"als","start":33,"eind":36},{"woord":"de","start":37,"eind":39},{"woord":"van","start":47,"eind":50},{"woord":"de","start":51,"eind":53},{"woord":"als","start":59,"eind":62},{"woord":"het","start":63,"eind":66},{"woord":"dat","start":86,"eind":89},{"woord":"heeft","start":103,"eind":108}]},{"ref":"habakuk/1/15","tekst":" Hij trekt ze allen met de angel op, hij verzamelt ze in zijn garen, en hij verzamelt ze in zijn net; daarom verblijdt en verheugt hij zich.","woorden":[{"woord":"Hij","start":1,"eind":4},{"woord":"ze","start":11,"eind":13},{"woord":"met","start":20,"eind":23},{"woord":"de","start":24,"eind":26},{"woord":"op","start":33,"eind":35},{"woord":"hij","start":37,"eind":40},{"woord":"ze","start":51,"eind":53},{"woord":"in","start":54,"eind":56},{"woord":"zijn","start":57,"eind":61},{"woord":"en","start":69,"eind":71},{"woord":"hij","start":72,"eind":75},{"woord":"ze","start":86,"eind":88},{"woord":"in","start":89,"eind":91},{"woord":"zijn","start":92,"eind":96},{"woord":"en","start":119,"eind":121},{"woord":"hij","start":131,"eind":134},{"woord":"zich","start":135,"eind":139}]},{"ref":"habakuk/1/16","tekst":" Daarom offert hij aan zijn garen, en rookt aan zijn net; want daardoor is zijn deel vet geworden, en zijn voedsel smoutig.","woorden":[{"woord":"hij","start":15,"eind":18},{"woord":"aan","start":19,"eind":22},{"woord":"zijn","start":23,"eind":27},{"woord":"en","start":35,"eind":37},{"woord":"aan","start":44,"eind":47},{"woord":"zijn","start":48,"eind":52},{"woord":"is","start":72,"eind":74},{"woord":"zijn","start":75,"eind":79},{"woord":"geworden","start":89,"eind":97},{"woord":"en","start":99,"eind":101},{"woord":"zijn","start":102,"eind":106}]},{"ref":"habakuk/1/17","tekst":" Zal hij dan daarom altijd zijn garen leeg maken, en zal hij niet sparen, met altijd de volken te doden?","woorden":[{"woord":"Zal","start":1,"eind":4},{"woord":"hij","start":5,"eind":8},{"woord":"dan","start":9,"eind":12},{"woord":"altijd","start":20,"eind":26},{"woord":"zijn","start":27,"eind":31},{"woord":"en","start":50,"eind":52},{"woord":"zal","start":53,"eind":56},{"woord":"hij","start":57,"eind":60},{"woord":"met","start":74,"eind":77},{"woord":"de","start":85,"eind":87},{"woord":"te","start":95,"eind":97}]},{"ref":"habakuk/2/1","tekst":" Ik stond op mijn wacht, en ik stelde mij op de vesting, en ik hield wacht om te zien, wat Hij in mij spreken zou, en wat ik antwoorden zou op mijn bestraffing.","woorden":[{"woord":"Ik","start":1,"eind":3},{"woord":"mijn","start":13,"eind":17},{"woord":"en","start":25,"eind":27},{"woord":"ik","start":28,"eind":30},{"woord":"mij","start":38,"eind":41},{"woord":"de","start":45,"eind":47},{"woord":"en","start":57,"eind":59},{"woord":"ik","start":60,"eind":62},{"woord":"om","start":75,"eind":77},{"woord":"te","start":78,"eind":80},{"woord":"Hij","start":91,"eind":94},{"woord":"in","start":95,"eind":97},{"woord":"mij","start":98,"eind":101},{"woord":"zou","start":110,"eind":113},{"woord":"en","start":115,"eind":117},{"woord":"ik","start":122,"eind":124},{"woord":"zou","start":136,"eind":139},{"woord":"mijn","start":143,"eind":147}]},{"ref":"habakuk/2/2","tekst":"Toen antwoordde mij JAHWEH, en zei: Schrijf het visioen, en stel het duidelijk op tafelen, opdat daarin leze die voorbijloopt.","woorden":[{"woord":"Toen","start":0,"eind":4},{"woord":"mij","start":16,"eind":19},{"woord":"en","start":28,"eind":30},{"woord":"het","start":44,"eind":47},{"woord":"en","start":57,"eind":59},{"woord":"stel","start":60,"eind":64},{"woord":"het","start":65,"eind":68},{"woord":"daarin","start":97,"eind":103},{"woord":"die","start":109,"eind":112}]},{"ref":"habakuk/2/3","tekst":"Want het visioen zal nog tot een bestemden tijd zijn, dan zal Hij het op het einde voortbrengen, en niet liegen; zo Hij wacht, verwacht Hem, want Hij zal zeker komen, Hij zal niet achterblijven.","woorden":[{"woord":"het","start":5,"eind":8},{"woord":"zal","start":17,"eind":20},{"woord":"tot","start":25,"eind":28},{"woord":"een","start":29,"eind":32},{"woord":"zijn","start":48,"eind":52},{"woord":"dan","start":54,"eind":57},{"woord":"zal","start":58,"eind":61},{"woord":"Hij","start":62,"eind":65},{"woord":"het","start":66,"eind":69},{"woord":"op","start":70,"eind":72},{"woord":"het","start":73,"eind":76},{"woord":"en","start":97,"eind":99},{"woord":"Hij","start":116,"eind":119},{"woord":"Hem","start":136,"eind":139},{"woord":"Hij","start":146,"eind":149},{"woord":"zal","start":150,"eind":153},{"woord":"Hij","start":167,"eind":170},{"woord":"zal","start":171,"eind":174}]},{"ref":"habakuk/2/4","tekst":"Zie, zijn ziel verheft zich, zij is niet recht in hem; maar de rechtvaardige zal door zijn geloof leven.","woorden":[{"woord":"zijn","start":5,"eind":9},{"woord":"zich","start":23,"eind":27},{"woord":"zij","start":29,"eind":32},{"woord":"is","start":33,"eind":35},{"woord":"in","start":47,"eind":49},{"woord":"hem","start":50,"eind":53},{"woord":"maar","start":55,"eind":59},{"woord":"de","start":60,"eind":62},{"woord":"zal","start":77,"eind":80},{"woord":"door","start":81,"eind":85},{"woord":"zijn","start":86,"eind":90}]},{"ref":"habakuk/2/5","tekst":"En ook omdat hij trouweloos handelt bij de wijn, een trots man is, en in zijn woning niet blijft; die zijn ziel wijd opendoet als het graf, en gelijk de dood is, die niet verzadigd wordt, en tot zich verzamelt al de heidenen, en verzamelt tot zich alle volken.","woorden":[{"woord":"En","start":0,"eind":2},{"woord":"hij","start":13,"eind":16},{"woord":"handelt","start":28,"eind":35},{"woord":"bij","start":36,"eind":39},{"woord":"de","start":40,"eind":42},{"woord":"een","start":49,"eind":52},{"woord":"is","start":63,"eind":65},{"woord":"en","start":67,"eind":69},{"woord":"in","start":70,"eind":72},{"woord":"zijn","start":73,"eind":77},{"woord":"woning","start":78,"eind":84},{"woord":"zijn","start":102,"eind":106},{"woord":"opendoet","start":117,"eind":125},{"woord":"als","start":126,"eind":129},{"woord":"het","start":130,"eind":133},{"woord":"en","start":140,"eind":142},{"woord":"gelijk","start":143,"eind":149},{"woord":"de","start":150,"eind":152},{"woord":"die","start":162,"eind":165},{"woord":"wordt","start":181,"eind":186},{"woord":"en","start":188,"eind":190},{"woord":"de","start":213,"eind":215},{"woord":"en","start":226,"eind":228}]},{"ref":"habakuk/2/6","tekst":" Zouden dan niet zij allen van hem een spreekwoord opnemen, en een uitlegging van de raadselen van hem? En men zal zeggen: Wee die, die vermeerdert wat het zijne niet is (hoe lange!), en die, die op zich laadt dik slijk.","woorden":[{"woord":"Zouden","start":1,"eind":7},{"woord":"dan","start":8,"eind":11},{"woord":"een","start":35,"eind":38},{"woord":"en","start":60,"eind":62},{"woord":"een","start":63,"eind":66},{"woord":"van","start":78,"eind":81},{"woord":"de","start":82,"eind":84},{"woord":"van","start":95,"eind":98},{"woord":"hem","start":99,"eind":102},{"woord":"En","start":104,"eind":106},{"woord":"men","start":107,"eind":110},{"woord":"zal","start":111,"eind":114},{"woord":"die","start":127,"eind":130},{"woord":"die","start":132,"eind":135},{"woord":"wat","start":148,"eind":151},{"woord":"het","start":152,"eind":155},{"woord":"zijne","start":156,"eind":161},{"woord":"is","start":167,"eind":169},{"woord":"en","start":184,"eind":186},{"woord":"die","start":187,"eind":190},{"woord":"die","start":192,"eind":195},{"woord":"dik","start":210,"eind":213}]},{"ref":"habakuk/2/7","tekst":" Zullen niet onvoorziens opstaan, die u bijten zullen, en ontwaken, die u zullen bewegen, en zult u hun niet tot plundering worden?","woorden":[{"woord":"Zullen","start":1,"eind":7},{"woord":"die","start":34,"eind":37},{"woord":"u","start":38,"eind":39},{"woord":"zullen","start":47,"eind":53},{"woord":"en","start":55,"eind":57},{"woord":"die","start":68,"eind":71},{"woord":"u","start":72,"eind":73},{"woord":"zullen","start":74,"eind":80},{"woord":"en","start":90,"eind":92},{"woord":"zult","start":93,"eind":97},{"woord":"u","start":98,"eind":99},{"woord":"hun","start":100,"eind":103},{"woord":"niet","start":104,"eind":108},{"woord":"tot","start":109,"eind":112}]},{"ref":"habakuk/2/8","tekst":"Omdat u vele heidenen beroofd hebt, zo zullen alle overgeblevene volken u beroven; om het bloed van de mensen, en het geweld aan het land, de stad, en alle inwoners daarvan.","woorden":[{"woord":"hebt","start":30,"eind":34},{"woord":"zo","start":36,"eind":38},{"woord":"zullen","start":39,"eind":45},{"woord":"u","start":72,"eind":73},{"woord":"om","start":83,"eind":85},{"woord":"het","start":86,"eind":89},{"woord":"van","start":96,"eind":99},{"woord":"de","start":100,"eind":102},{"woord":"en","start":111,"eind":113},{"woord":"het","start":114,"eind":117},{"woord":"aan","start":125,"eind":128},{"woord":"het","start":129,"eind":132},{"woord":"de","start":139,"eind":141},{"woord":"en","start":148,"eind":150},{"woord":"daarvan","start":165,"eind":172}]},{"ref":"habakuk/2/9","tekst":"Wee die, die met kwade gierigheid giert voor zijn huis, opdat hij in de hoogte zijn nest stelle, om bevrijd te zijn uit de hand van het kwaad.","woorden":[{"woord":"die","start":4,"eind":7},{"woord":"die","start":9,"eind":12},{"woord":"met","start":13,"eind":16},{"woord":"voor","start":40,"eind":44},{"woord":"zijn","start":45,"eind":49},{"woord":"opdat","start":56,"eind":61},{"woord":"hij","start":62,"eind":65},{"woord":"in","start":66,"eind":68},{"woord":"de","start":69,"eind":71},{"woord":"zijn","start":79,"eind":83},{"woord":"om","start":97,"eind":99},{"woord":"te","start":108,"eind":110},{"woord":"zijn","start":111,"eind":115},{"woord":"uit","start":116,"eind":119},{"woord":"de","start":120,"eind":122},{"woord":"van","start":128,"eind":131},{"woord":"het","start":132,"eind":135}]},{"ref":"habakuk/2/10","tekst":" U hebt schaamte beraadslaagd voor uw huis; uitroeiende vele volken, zo hebt u gezondigd tegen uw ziel.","woorden":[{"woord":"U","start":1,"eind":2},{"woord":"hebt","start":3,"eind":7},{"woord":"voor","start":30,"eind":34},{"woord":"uw","start":35,"eind":37},{"woord":"zo","start":69,"eind":71},{"woord":"hebt","start":72,"eind":76},{"woord":"u","start":77,"eind":78},{"woord":"tegen","start":89,"eind":94},{"woord":"uw","start":95,"eind":97}]},{"ref":"habakuk/2/11","tekst":"Want de steen uit de muur roept, en de balk uit het hout antwoordt die.","woorden":[{"woord":"de","start":5,"eind":7},{"woord":"uit","start":14,"eind":17},{"woord":"de","start":18,"eind":20},{"woord":"en","start":33,"eind":35},{"woord":"de","start":36,"eind":38},{"woord":"uit","start":44,"eind":47},{"woord":"het","start":48,"eind":51},{"woord":"die","start":67,"eind":70}]},{"ref":"habakuk/2/12","tekst":"Wee die, die de stad met bloed bouwt, en die de stad met onrecht bevestigt!","woorden":[{"woord":"die","start":4,"eind":7},{"woord":"die","start":9,"eind":12},{"woord":"de","start":13,"eind":15},{"woord":"met","start":21,"eind":24},{"woord":"en","start":38,"eind":40},{"woord":"die","start":41,"eind":44},{"woord":"de","start":45,"eind":47},{"woord":"met","start":53,"eind":56}]},{"ref":"habakuk/2/13","tekst":"Zie, is het niet van JAHWEH van de legermachten, dat de volken arbeiden ten vure, en de mensen zich vermoeien tevergeefs?","woorden":[{"woord":"is","start":5,"eind":7},{"woord":"het","start":8,"eind":11},{"woord":"van","start":28,"eind":31},{"woord":"de","start":32,"eind":34},{"woord":"dat","start":49,"eind":52},{"woord":"de","start":53,"eind":55},{"woord":"en","start":82,"eind":84},{"woord":"de","start":85,"eind":87},{"woord":"zich","start":95,"eind":99}]},{"ref":"habakuk/2/14","tekst":"Want de aarde zal vervuld worden, dat zij de heerlijkheid van JAHWEH bekennen, zoals de wateren de bodem van de zee bedekken.","woorden":[{"woord":"de","start":5,"eind":7},{"woord":"zal","start":14,"eind":17},{"woord":"worden","start":26,"eind":32},{"woord":"dat","start":34,"eind":37},{"woord":"zij","start":38,"eind":41},{"woord":"de","start":42,"eind":44},{"woord":"van","start":58,"eind":61},{"woord":"zoals","start":79,"eind":84},{"woord":"de","start":85,"eind":87},{"woord":"de","start":96,"eind":98},{"woord":"bodem","start":99,"eind":104},{"woord":"van","start":105,"eind":108},{"woord":"de","start":109,"eind":111}]},{"ref":"habakuk/2/15","tekst":"Wee die, die zijn naaste te drinken geeft, u, die uw wijnfles daarbij voegt, en ook dronken maakt, opdat u hun naaktheden aanschouwt.","woorden":[{"woord":"die","start":4,"eind":7},{"woord":"die","start":9,"eind":12},{"woord":"zijn","start":13,"eind":17},{"woord":"te","start":25,"eind":27},{"woord":"geeft","start":36,"eind":41},{"woord":"u","start":43,"eind":44},{"woord":"die","start":46,"eind":49},{"woord":"uw","start":50,"eind":52},{"woord":"daarbij","start":62,"eind":69},{"woord":"en","start":77,"eind":79},{"woord":"maakt","start":92,"eind":97},{"woord":"u","start":105,"eind":106},{"woord":"hun","start":107,"eind":110}]},{"ref":"habakuk/2/16","tekst":" U zult ook verzadigd worden met schande, voor eer; drink u ook, en ontbloot de voorhuid; de beker van de rechterhand van JAHWEH zal zich tot u wenden, en er zal een schandelijk uitbraaksel over uw heerlijkheid zijn.","woorden":[{"woord":"U","start":1,"eind":2},{"woord":"zult","start":3,"eind":7},{"woord":"ook","start":8,"eind":11},{"woord":"worden","start":22,"eind":28},{"woord":"met","start":29,"eind":32},{"woord":"voor","start":42,"eind":46},{"woord":"en","start":65,"eind":67},{"woord":"de","start":77,"eind":79},{"woord":"voorhuid","start":80,"eind":88},{"woord":"de","start":90,"eind":92},{"woord":"van","start":99,"eind":102},{"woord":"de","start":103,"eind":105},{"woord":"van","start":118,"eind":121},{"woord":"zal","start":129,"eind":132},{"woord":"zich","start":133,"eind":137},{"woord":"en","start":152,"eind":154},{"woord":"er","start":155,"eind":157},{"woord":"zal","start":158,"eind":161},{"woord":"een","start":162,"eind":165},{"woord":"schandelijk","start":166,"eind":177},{"woord":"uw","start":195,"eind":197},{"woord":"zijn","start":211,"eind":215}]},{"ref":"habakuk/2/17","tekst":"Want het geweld, dat tegen Libanon begaan is, zal u bedekken, en de verwoesting van de beesten zal ze verschrikken, vanwege het bloed van de mensen, en van het geweld in het land, de stad en aan alle inwoners daarvan.","woorden":[{"woord":"het","start":5,"eind":8},{"woord":"dat","start":17,"eind":20},{"woord":"tegen","start":21,"eind":26},{"woord":"begaan","start":35,"eind":41},{"woord":"is","start":42,"eind":44},{"woord":"zal","start":46,"eind":49},{"woord":"u","start":50,"eind":51},{"woord":"en","start":62,"eind":64},{"woord":"de","start":65,"eind":67},{"woord":"van","start":80,"eind":83},{"woord":"de","start":84,"eind":86},{"woord":"zal","start":95,"eind":98},{"woord":"ze","start":99,"eind":101},{"woord":"vanwege","start":116,"eind":123},{"woord":"het","start":124,"eind":127},{"woord":"van","start":134,"eind":137},{"woord":"de","start":138,"eind":140},{"woord":"en","start":149,"eind":151},{"woord":"van","start":152,"eind":155},{"woord":"het","start":156,"eind":159},{"woord":"in","start":167,"eind":169},{"woord":"het","start":170,"eind":173},{"woord":"de","start":180,"eind":182},{"woord":"en","start":188,"eind":190},{"woord":"aan","start":191,"eind":194},{"woord":"daarvan","start":209,"eind":216}]},{"ref":"habakuk/2/18","tekst":" Wat zal het gesneden beeld baten, dat zijn formeerder het gesneden heeft? of het gegoten beeld, dat een leugenleraar is, dat de formeerder op zijn formeersel vertrouwt, als hij stomme afgoden gemaakt heeft?","woorden":[{"woord":"zal","start":5,"eind":8},{"woord":"het","start":9,"eind":12},{"woord":"zijn","start":39,"eind":43},{"woord":"het","start":55,"eind":58},{"woord":"heeft","start":68,"eind":73},{"woord":"of","start":75,"eind":77},{"woord":"het","start":78,"eind":81},{"woord":"dat","start":97,"eind":100},{"woord":"een","start":101,"eind":104},{"woord":"is","start":118,"eind":120},{"woord":"de","start":126,"eind":128},{"woord":"zijn","start":143,"eind":147},{"woord":"als","start":170,"eind":173},{"woord":"hij","start":174,"eind":177},{"woord":"heeft","start":201,"eind":206}]},{"ref":"habakuk/2/19","tekst":"Wee die, die tot het hout zegt: Word wakker! en: Ontwaak! tot de zwijgenden steen. Zou het leren? Zie, het is met goud en zilver overtrokken, en er is geheel geen geest in het midden daarvan.","woorden":[{"woord":"die","start":4,"eind":7},{"woord":"die","start":9,"eind":12},{"woord":"tot","start":13,"eind":16},{"woord":"het","start":17,"eind":20},{"woord":"en","start":45,"eind":47},{"woord":"tot","start":58,"eind":61},{"woord":"de","start":62,"eind":64},{"woord":"Zou","start":83,"eind":86},{"woord":"is","start":107,"eind":109},{"woord":"met","start":110,"eind":113},{"woord":"en","start":119,"eind":121},{"woord":"en","start":142,"eind":144},{"woord":"er","start":145,"eind":147},{"woord":"is","start":148,"eind":150},{"woord":"in","start":169,"eind":171},{"woord":"het","start":172,"eind":175},{"woord":"daarvan","start":183,"eind":190}]},{"ref":"habakuk/2/20","tekst":"Maar JAHWEH is in Zijn heilige tempel. Zwijg voor Zijn aangezicht, u hele aarde!","woorden":[{"woord":"Maar","start":0,"eind":4},{"woord":"is","start":12,"eind":14},{"woord":"in","start":15,"eind":17},{"woord":"Zijn","start":18,"eind":22},{"woord":"voor","start":45,"eind":49},{"woord":"Zijn","start":50,"eind":54},{"woord":"u","start":67,"eind":68}]},{"ref":"habakuk/3/1","tekst":"Een gebed van Habakuk, de profeet, op Sjigjonoth.","woorden":[{"woord":"Een","start":0,"eind":3},{"woord":"van","start":10,"eind":13},{"woord":"de","start":23,"eind":25}]},{"ref":"habakuk/3/2","tekst":"JAHWEH! als ik Uw rede gehoord heb, heb ik gevreesd; Uw werk, o JAHWEH! behoud dat in het leven in het midden van de jaren, maak het bekend in het midden van de jaren; in de toorn gedenk de ontferming.","woorden":[{"woord":"als","start":8,"eind":11},{"woord":"ik","start":12,"eind":14},{"woord":"Uw","start":15,"eind":17},{"woord":"heb","start":31,"eind":34},{"woord":"heb","start":36,"eind":39},{"woord":"ik","start":40,"eind":42},{"woord":"Uw","start":53,"eind":55},{"woord":"o","start":62,"eind":63},{"woord":"behoud","start":72,"eind":78},{"woord":"dat","start":79,"eind":82},{"woord":"in","start":83,"eind":85},{"woord":"het","start":86,"eind":89},{"woord":"in","start":96,"eind":98},{"woord":"het","start":99,"eind":102},{"woord":"van","start":110,"eind":113},{"woord":"de","start":114,"eind":116},{"woord":"maak","start":124,"eind":128},{"woord":"het","start":129,"eind":132},{"woord":"in","start":140,"eind":142},{"woord":"het","start":143,"eind":146},{"woord":"van","start":154,"eind":157},{"woord":"de","start":158,"eind":160},{"woord":"in","start":168,"eind":170},{"woord":"de","start":171,"eind":173},{"woord":"de","start":187,"eind":189}]},{"ref":"habakuk/3/3","tekst":" God kwam van Theman, en de Heilige van de berg Paran. Sela. Zijn heerlijkheid bedekte de hemelen, en het aardrijk was vol van Zijn lof.","woorden":[{"woord":"van","start":10,"eind":13},{"woord":"en","start":22,"eind":24},{"woord":"de","start":25,"eind":27},{"woord":"van","start":36,"eind":39},{"woord":"de","start":40,"eind":42},{"woord":"Zijn","start":61,"eind":65},{"woord":"de","start":87,"eind":89},{"woord":"en","start":99,"eind":101},{"woord":"het","start":102,"eind":105},{"woord":"was","start":115,"eind":118},{"woord":"van","start":123,"eind":126},{"woord":"Zijn","start":127,"eind":131}]},{"ref":"habakuk/3/4","tekst":"En er was een glans als van het licht, Hij had hoornen aan Zijn hand, en daar was Zijn sterkte verborgen.","woorden":[{"woord":"En","start":0,"eind":2},{"woord":"er","start":3,"eind":5},{"woord":"een","start":10,"eind":13},{"woord":"als","start":20,"eind":23},{"woord":"van","start":24,"eind":27},{"woord":"het","start":28,"eind":31},{"woord":"Hij","start":39,"eind":42},{"woord":"had","start":43,"eind":46},{"woord":"aan","start":55,"eind":58},{"woord":"Zijn","start":59,"eind":63},{"woord":"en","start":70,"eind":72},{"woord":"was","start":78,"eind":81},{"woord":"Zijn","start":82,"eind":86}]},{"ref":"habakuk/3/5","tekst":" Voor Zijn aangezicht ging de pest, en de vurige kool ging voor Zijn voeten heen.","woorden":[{"woord":"Voor","start":1,"eind":5},{"woord":"Zijn","start":6,"eind":10},{"woord":"de","start":27,"eind":29},{"woord":"en","start":36,"eind":38},{"woord":"de","start":39,"eind":41},{"woord":"voor","start":59,"eind":63},{"woord":"Zijn","start":64,"eind":68},{"woord":"heen","start":76,"eind":80}]},{"ref":"habakuk/3/6","tekst":" Hij stond, en mat het land, Hij zag toe, en maakte de heidenen los, en de aloude bergen zijn verstrooid geworden; de heuvelen van de eeuwigheid hebben zich gebogen; de gangen van de eeuw zijn van Hem.","woorden":[{"woord":"Hij","start":1,"eind":4},{"woord":"en","start":12,"eind":14},{"woord":"het","start":19,"eind":22},{"woord":"Hij","start":29,"eind":32},{"woord":"toe","start":37,"eind":40},{"woord":"en","start":42,"eind":44},{"woord":"maakte","start":45,"eind":51},{"woord":"de","start":52,"eind":54},{"woord":"en","start":69,"eind":71},{"woord":"de","start":72,"eind":74},{"woord":"zijn","start":89,"eind":93},{"woord":"geworden","start":105,"eind":113},{"woord":"de","start":115,"eind":117},{"woord":"van","start":127,"eind":130},{"woord":"de","start":131,"eind":133},{"woord":"hebben","start":145,"eind":151},{"woord":"zich","start":152,"eind":156},{"woord":"de","start":166,"eind":168},{"woord":"van","start":176,"eind":179},{"woord":"de","start":180,"eind":182},{"woord":"zijn","start":188,"eind":192},{"woord":"van","start":193,"eind":196},{"woord":"Hem","start":197,"eind":200}]},{"ref":"habakuk/3/7","tekst":" Ik zag de tenten van Kusan onder de zinloosheid; de gordijnen van het land van Midian schudden.","woorden":[{"woord":"Ik","start":1,"eind":3},{"woord":"de","start":8,"eind":10},{"woord":"van","start":18,"eind":21},{"woord":"de","start":34,"eind":36},{"woord":"de","start":50,"eind":52},{"woord":"van","start":63,"eind":66},{"woord":"het","start":67,"eind":70},{"woord":"van","start":76,"eind":79}]},{"ref":"habakuk/3/8","tekst":"Was JAHWEH ontstoken tegen de rivieren? Was Uw toorn tegen de rivieren, was Uw toorn tegen de zee, toen U op Uw paarden reedt? Uw wagens waren heil.","woorden":[{"woord":"Was","start":0,"eind":3},{"woord":"tegen","start":21,"eind":26},{"woord":"de","start":27,"eind":29},{"woord":"Uw","start":44,"eind":46},{"woord":"tegen","start":53,"eind":58},{"woord":"de","start":59,"eind":61},{"woord":"Uw","start":76,"eind":78},{"woord":"tegen","start":85,"eind":90},{"woord":"de","start":91,"eind":93},{"woord":"U","start":104,"eind":105},{"woord":"Uw","start":109,"eind":111},{"woord":"Uw","start":127,"eind":129},{"woord":"waren","start":137,"eind":142}]},{"ref":"habakuk/3/9","tekst":" De naakte grond werd ontbloot door Uw boog, om de eden, aan de stammen gedaan door het woord. Sela. U hebt de rivieren van de aarde gekloofd.","woorden":[{"woord":"De","start":1,"eind":3},{"woord":"grond","start":11,"eind":16},{"woord":"werd","start":17,"eind":21},{"woord":"door","start":31,"eind":35},{"woord":"Uw","start":36,"eind":38},{"woord":"om","start":45,"eind":47},{"woord":"de","start":48,"eind":50},{"woord":"aan","start":57,"eind":60},{"woord":"de","start":61,"eind":63},{"woord":"gedaan","start":72,"eind":78},{"woord":"door","start":79,"eind":83},{"woord":"het","start":84,"eind":87},{"woord":"U","start":101,"eind":102},{"woord":"hebt","start":103,"eind":107},{"woord":"de","start":108,"eind":110},{"woord":"van","start":120,"eind":123},{"woord":"de","start":124,"eind":126}]},{"ref":"habakuk/3/10","tekst":" De bergen zagen U, en leden smart; de waterstroom ging door, de afgrond gaf zijn stem, hij hief zijn zijden op in de hoogte.","woorden":[{"woord":"De","start":1,"eind":3},{"woord":"U","start":17,"eind":18},{"woord":"en","start":20,"eind":22},{"woord":"leden","start":23,"eind":28},{"woord":"de","start":36,"eind":38},{"woord":"door","start":56,"eind":60},{"woord":"de","start":62,"eind":64},{"woord":"zijn","start":77,"eind":81},{"woord":"hij","start":88,"eind":91},{"woord":"zijn","start":97,"eind":101},{"woord":"op","start":109,"eind":111},{"woord":"in","start":112,"eind":114},{"woord":"de","start":115,"eind":117}]},{"ref":"habakuk/3/11","tekst":"De zon en de maan stonden stil in haar woning; met het licht gingen Uw pijlen daarheen, met glans Uw bliksemende speer.","woorden":[{"woord":"De","start":0,"eind":2},{"woord":"en","start":7,"eind":9},{"woord":"de","start":10,"eind":12},{"woord":"in","start":31,"eind":33},{"woord":"haar","start":34,"eind":38},{"woord":"met","start":47,"eind":50},{"woord":"het","start":51,"eind":54},{"woord":"Uw","start":68,"eind":70},{"woord":"daarheen","start":78,"eind":86},{"woord":"met","start":88,"eind":91},{"woord":"Uw","start":98,"eind":100}]},{"ref":"habakuk/3/12","tekst":" Met toorn tradt U door het land, met toorn dorstet U de heidenen.","woorden":[{"woord":"Met","start":1,"eind":4},{"woord":"U","start":17,"eind":18},{"woord":"door","start":19,"eind":23},{"woord":"het","start":24,"eind":27},{"woord":"met","start":34,"eind":37},{"woord":"U","start":52,"eind":53},{"woord":"de","start":54,"eind":56}]},{"ref":"habakuk/3/13","tekst":"U toogt uit tot verlossing van Uw volk, tot verlossing met Uw Gezalfde; U doorwondde het hoofd van het huis van de goddelozen, ontblotende de grond tot de hals toe. Sela.","woorden":[{"woord":"U","start":0,"eind":1},{"woord":"uit","start":8,"eind":11},{"woord":"tot","start":12,"eind":15},{"woord":"van","start":27,"eind":30},{"woord":"Uw","start":31,"eind":33},{"woord":"tot","start":40,"eind":43},{"woord":"Uw","start":59,"eind":61},{"woord":"U","start":72,"eind":73},{"woord":"het","start":85,"eind":88},{"woord":"van","start":95,"eind":98},{"woord":"het","start":99,"eind":102},{"woord":"van","start":108,"eind":111},{"woord":"de","start":112,"eind":114},{"woord":"de","start":139,"eind":141},{"woord":"de","start":152,"eind":154},{"woord":"toe","start":160,"eind":163}]},{"ref":"habakuk/3/14","tekst":"U doorboorde met zijn staven het hoofd van zijn dorplieden; zij hebben gestormd, om mij te verstrooien; die zich verheugden, alsof zij de ellendigen in het verborgen zouden opeten.",