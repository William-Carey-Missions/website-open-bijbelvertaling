{"boek":"habakuk","inhoudelijke_controle_voltooid":false,"verzen":56,"koppelingen":644,"verzen_zonder_grondtekst":0,"verzen_zonder_koppelingslaag":0,"fouten":[],"woorden_zonder_link":[{"ref":"habakuk/1/1","tekst":" De last, die Habakuk, de profeet, gezien heeft.","woorden":[{"woord":"De","start":1,"eind":3},{"woord":"de","start":23,"eind":25},{"woord":"heeft","start":42,"eind":47}]},{"ref":"habakuk/1/2","tekst":"JAHWEH! hoe lang schreeuw ik, en U hoort niet, hoe lang roep ik geweld, tot U, en U verlost niet!","woorden":[{"woord":"ik","start":26,"eind":28},{"woord":"en","start":30,"eind":32},{"woord":"U","start":33,"eind":34},{"woord":"hoe","start":47,"eind":50},{"woord":"lang","start":51,"eind":55},{"woord":"ik","start":61,"eind":63},{"woord":"en","start":79,"eind":81},{"woord":"U","start":82,"eind":83}]},{"ref":"habakuk/1/3","tekst":"Waarom laat U mij ongerechtigheid zien, en aanschouwt de kwelling? Want verwoesting en geweld is tegen mij over, en er is twist, en er ontstaat ruzie.","woorden":[{"woord":"laat","start":7,"eind":11},{"woord":"U","start":12,"eind":13},{"woord":"mij","start":14,"eind":17},{"woord":"en","start":40,"eind":42},{"woord":"de","start":54,"eind":56},{"woord":"Want","start":67,"eind":71},{"woord":"en","start":84,"eind":86},{"woord":"is","start":94,"eind":96},{"woord":"over","start":107,"eind":111},{"woord":"en","start":113,"eind":115},{"woord":"er","start":116,"eind":118},{"woord":"en","start":129,"eind":131},{"woord":"er","start":132,"eind":134}]},{"ref":"habakuk/1/4","tekst":"Daarom wordt de wet onderlaten, en het recht komt nimmermeer voort; want de goddeloze omringt de rechtvaardige; daarom komt het recht verdraaid voor.","woorden":[{"woord":"wordt","start":7,"eind":12},{"woord":"de","start":13,"eind":15},{"woord":"en","start":32,"eind":34},{"woord":"het","start":35,"eind":38},{"woord":"voort","start":61,"eind":66},{"woord":"de","start":73,"eind":75},{"woord":"de","start":94,"eind":96},{"woord":"het","start":124,"eind":127},{"woord":"voor","start":144,"eind":148}]},{"ref":"habakuk/1/5","tekst":" Zie onder de heidenen, en aanschouwt, en verwondert u, verwondert u, want Ik werk een werk in uw dagen, dat u niet geloven zult, als het verteld zal worden.","woorden":[{"woord":"onder","start":5,"eind":10},{"woord":"de","start":11,"eind":13},{"woord":"en","start":24,"eind":26},{"woord":"en","start":39,"eind":41},{"woord":"u","start":53,"eind":54},{"woord":"u","start":67,"eind":68},{"woord":"Ik","start":75,"eind":77},{"woord":"een","start":83,"eind":86},{"woord":"in","start":92,"eind":94},{"woord":"uw","start":95,"eind":97},{"woord":"dat","start":105,"eind":108},{"woord":"u","start":109,"eind":110},{"woord":"zult","start":124,"eind":128},{"woord":"het","start":134,"eind":137},{"woord":"zal","start":146,"eind":149},{"woord":"worden","start":150,"eind":156}]},{"ref":"habakuk/1/6","tekst":"Want ziet, Ik verwek de Chaldeeën, een bitter en snel volk, trekkende door de breedten van de aarde, om erfelijk te bezitten woningen, die de zijne niet zijn.","woorden":[{"woord":"Ik","start":11,"eind":13},{"woord":"de","start":21,"eind":23},{"woord":"een","start":35,"eind":38},{"woord":"en","start":46,"eind":48},{"woord":"door","start":70,"eind":74},{"woord":"de","start":75,"eind":77},{"woord":"van","start":87,"eind":90},{"woord":"de","start":91,"eind":93},{"woord":"om","start":101,"eind":103},{"woord":"erfelijk","start":104,"eind":112},{"woord":"te","start":113,"eind":115},{"woord":"die","start":135,"eind":138},{"woord":"de","start":139,"eind":141},{"woord":"zijne","start":142,"eind":147},{"woord":"zijn","start":153,"eind":157}]},{"ref":"habakuk/1/7","tekst":"Schrikkelijk en vreselijk is het; zijn recht en zijn hoogheid gaat van hemzelf uit.","woorden":[{"woord":"en","start":13,"eind":15},{"woord":"is","start":26,"eind":28},{"woord":"zijn","start":34,"eind":38},{"woord":"en","start":45,"eind":47},{"woord":"zijn","start":48,"eind":52},{"woord":"uit","start":79,"eind":82}]},{"ref":"habakuk/1/8","tekst":" Want zijn paarden zijn